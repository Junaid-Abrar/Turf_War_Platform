# Turf War mobile app — build-time configuration
#
# Flutter has no runtime .env: these are compile-time constants passed with
# --dart-define and read through lib/core/config/app_config.dart. This file
# documents the keys; copy the values into your own run configuration, or use
# ./run.sh which reads a local .env and passes them for you.
#
#   cp .env.example .env

# Base URL of the REST API, including the /api prefix.
#
#   Android emulator  http://10.0.2.2:3000/api   (10.0.2.2 = host machine)
#   iOS simulator     http://localhost:3000/api
#   Physical device   http://<your-lan-ip>:3000/api
#   Deployed          https://<your-app>.onrender.com/api
API_BASE_URL=http://10.0.2.2:3000/api

# Stripe publishable key (pk_test_… for development).
# Leave empty to run without Stripe: the payment sheet is then simulated
# instead of failing, which is what the web demo build uses.
STRIPE_PUBLISHABLE_KEY=

# Demo mode stubs the Stripe payment sheet and skips FCM registration, for the
# public web demo where neither is available. Set to true only for that build.
DEMO_MODE=false
