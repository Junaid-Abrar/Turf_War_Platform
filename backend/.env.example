# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/turfwar?retryWrites=true&w=majority

# Port the API server listens on
PORT=3000

# JWT signing secret and expiry (e.g. "7d", "1h")
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# Cloudinary (venue image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Admin (push notifications) — optional.
# Either paste the full service-account JSON as a single-line string here,
# or drop the file at backend/config/service-account.json (gitignored).
# If neither is set, push notifications are silently disabled.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated list of origins allowed to call this API (web-admin, Flutter web build, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# development | production | test
NODE_ENV=development
